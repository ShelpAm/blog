# Webhook server that listens for GitHub push events and redeploys the site.
# At runtime, bind-mount the repo root to /site so that tools/deploy.sh
# can run `git pull` and pick up new content.
FROM ruby:3.3-alpine

RUN apk add --no-cache \
    build-base \
    git \
    python3 \
    py3-pip

WORKDIR /site

# Pre-install Ruby dependencies (layer-cached)
COPY Gemfile* ./
RUN gem install bundler && bundle install

# Pre-install Python dependencies (layer-cached)
COPY requirements.txt ./
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install -r requirements.txt

EXPOSE 9001

# At startup: do an initial site build, then start the webhook server.
# The repo is expected to be bind-mounted at /site (see docker-compose.yml).
# The webhook server starts even if the initial build fails so it can
# serve requests that trigger a rebuild.
CMD ["sh", "-c", "JEKYLL_ENV=production bundle exec jekyll b; /opt/venv/bin/python tools/webhook_server.py _site"]
